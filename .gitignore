# Local-only bus speed segment fixtures. Served from public/ during development so the
# speed map works before the /businsights CloudFront behaviour is deployed; must never be
# committed, since public/ is synced to the frontend bucket at deploy time.
public/businsights

# maplibre-gl's worker module, vended into public/maplibre-gl/<version>/ by
# copy-maplibre-worker.js (see scripts/copy-maplibre-worker.js for why). Copied fresh from
# node_modules on every `npm install`, so it should never be committed. The pattern also
# covers the loose public/maplibre-gl-*.mjs copies that older checkouts still have.
public/maplibre-gl*

# Playwright MCP snapshots, screenshots and console logs
.playwright-mcp/
