{
  "name": "t-performance-dash",
  "version": "4.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build-storybook": "storybook build",
    "generate-openapi": "cd server && uv run python -m scripts.generate_openapi && cd ..",
    "generate-oss-list": "generate-attribution --outputDir common/constants/licenses",
    "get-api-cache": "cd server && uv run python -m scripts.fetch_static_data && cd ..",
    "get-data": "npm run get-sz-totals && npm run get-szs && npm run get-speed-restrictions && npm run get-landing-trip-metrics && npm run get-landing-ridership && npm run get-landing-baselines && npm run get-api-cache",
    "get-landing-baselines": "wget -N -x -nH -P public https://dashboard.transitmatters.org/static/landing/baselines.json || true",
    "get-landing-ridership": "wget -N -x -nH -P public https://dashboard.transitmatters.org/static/landing/ridership.json",
    "get-landing-trip-metrics": "wget -N -x -nH -P public https://dashboard.transitmatters.org/static/landing/trip_metrics.json",
    "get-speed-restrictions": "cd server && uv run python -m scripts.update_speed_restrictions && cd ..",
    "get-sz-totals": "wget -N -x -nH -P public https://dashboard.transitmatters.org/static/slowzones/delay_totals.json",
    "get-szs": "wget -N -x -nH -P public https://dashboard.transitmatters.org/static/slowzones/all_slow.json",
    "copy-maplibre-worker": "node scripts/copy-maplibre-worker.js",
    "postinstall": "npm run copy-maplibre-worker && cd server && uv sync",
    "lint": "npm run lint-frontend && npm run lint-backend",
    "lint-backend": "cd server && uv run ruff check . && uv run ruff format . --check",
    "lint-backend-fix": "cd server && uv run ruff check . --fix && uv run ruff format .",
    "lint-frontend": "tsc --noEmit && eslint .",
    "lint-frontend-fix": "tsc --noEmit && eslint . --fix",
    "serve-static": "npm run build && serve out",
    "start": "concurrently npm:start-python npm:start-react",
    "start-python": "cd server && DD_TRACE_ENABLED=false DD_PROFILING_ENABLED=false uv run chalice local --port=5000",
    "start-react": "npm run get-data && vite",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "ui-add": "shadcn add",
    "dev": "vite"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@datadog/browser-rum": "^7.15.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@transitmatters/stripmap": "^0.1.16",
    "bezier-js": "^6.1.4",
    "chart.js": "4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-watermark": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "color": "^5.0.3",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "lodash": "^4.18.1",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "patternomaly": "^1.3.2",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-csv": "^2.2.2",
    "react-day-picker": "^10.0.2",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-lottie-player": "^2.1.0",
    "react-map-gl": "^8.1.3",
    "react-responsive": "^10.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/bezier-js": "^4.1.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-csv": "^1.1.10",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "baseline-browser-mapping": "^2.11.26",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "npm-attribution-generator": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=26.8.2",
    "npm": ">=11.0.0"
  },
  "volta": {
    "node": "26.8.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "core-js-pure": false
  }
}
